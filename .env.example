# --- Supabase ---
# Project Settings > API en tu proyecto de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Se usa en scripts/seed.ts Y en el pipeline de sync de Gmail (src/lib/supabase/service.ts),
# porque ese sync puede correr sin sesion de usuario (disparado por cron). NUNCA se expone
# al cliente/browser — solo se importa desde codigo server-only.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Auth ---
# Dominio de Google Workspace permitido para iniciar sesion (sin @)
ALLOWED_EMAIL_DOMAIN=tmcsudamerica.com.ar

# URL publica del sitio (usada para armar el redirect de OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI Provider ---
# Que proveedor usa el AI Normalizer. Valores soportados en V1: "anthropic"
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Opcional. Si se omite, el codigo usa "claude-sonnet-5" por defecto (ver src/lib/ai/anthropicProvider.ts).
ANTHROPIC_MODEL=claude-sonnet-5

# --- Gmail (Etapa 2) ---
# Mismas credenciales OAuth que configuraste en Supabase Dashboard > Authentication >
# Providers > Google (Client ID / Client Secret de Google Cloud Console). Se usan aca
# TAMBIEN, de forma independiente, para poder refrescar el access_token de Gmail en
# background (fuera de una sesion de usuario) — ver src/lib/google/oauthClient.ts.
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Direcciones de email que son "el usuario" (para distinguir INBOUND/OUTBOUND). Separadas
# por coma. Incluir todos los alias corporativos que puedan aparecer en el campo From.
USER_EMAIL_ADDRESSES=felipe@tmcsudamerica.com.ar

# Equipo interno de TMC — se le muestra al AI Case Analyzer para distinguir actividad del
# equipo de accion de Felipe (ver src/lib/cases/teamMembers.ts). Formato "Nombre <email>",
# separados por coma.
INTERNAL_TEAM_MEMBERS=Felipe <felipe@tmcsudamerica.com.ar>,Thomas <thomas@tmcsudamerica.com.ar>

# Cada cuantos minutos correr el sync incremental de Gmail cuando se dispara via cron.
GMAIL_POLL_INTERVAL_MINUTES=10

# Rango por defecto (en dias) para el bootstrap inicial si el usuario no elige uno.
GMAIL_BOOTSTRAP_DEFAULT_DAYS=14

# Secreto compartido para que un cron externo (ej. Vercel Cron) pueda llamar a
# /api/gmail/sync y /api/cases/sync sin una sesion de usuario. Generar algo random largo, ej:
# openssl rand -hex 32
CRON_SECRET=cambiar-por-un-secreto-largo-y-random

# Pipeline legacy de Work Item (creado por email desde Gmail) — desactivado por default desde
# que el Dashboard/Kanban corre sobre Case (ver src/lib/cases/). Dejarlo en false evita
# analizar cada email dos veces (una por Work Item, otra por Case) y duplicar el costo de IA.
# Los Work Items historicos y sus tablas quedan intactos, solo se frena la sincronizacion
# automatica de nuevos. Poner en "true" para reactivarlo (reversible, no requiere cambiar
# codigo).
WORK_ITEM_GMAIL_SYNC_ENABLED=false

# Clave de cifrado (AES-256-GCM) para access_token/refresh_token de Google antes de
# guardarlos en la DB (ver src/lib/google/tokenCrypto.ts). Debe decodificar a exactamente
# 32 bytes. Generar con: openssl rand -hex 32   (o: openssl rand -base64 32)
GOOGLE_TOKEN_ENCRYPTION_KEY=cambiar-por-32-bytes-en-hex-o-base64

# --- WhatsApp Quick Capture (V1) ---
# Token estatico que valida POST /api/capture/whatsapp (usado por el Apple Shortcut, ver
# README.md#whatsapp-quick-capture). Generar algo random largo, ej: openssl rand -hex 32
WHATSAPP_CAPTURE_TOKEN=cambiar-por-un-secreto-largo-y-random

# --- Zapia (WhatsApp → Zapia → Work OS) ---
# Token estatico que valida POST /api/capture/zapia (webhook oficial de Zapia). Generar
# algo random largo, ej: openssl rand -hex 32. Pegar este mismo valor en la configuracion
# de credencial protegida de Zapia (header Authorization: Bearer <valor>).
ZAPIA_WEBHOOK_SECRET=cambiar-por-un-secreto-largo-y-random
